# ── App ──────────────────────────────────────────────────────────────────────
# Public site URL (no trailing slash). Used in emails, sitemap, OG tags.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Postgres + Storage) ────────────────────────────────────────────
# Without these, the app falls back to a local filesystem store (.storage)
# so the full flow still works in dev. See README "Supabase setup".
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-service-role-key

# ── Replicate (background removal) ───────────────────────────────────────────
# Without a token, a mock returns the original image flagged mockBackground=true.
REPLICATE_API_TOKEN=r8_dummy_replicate_token_1234567890abcdef

# ── Stripe (one-time checkout) ───────────────────────────────────────────────
# Without keys, MOCK payments are used: checkout redirects to a dev-only
# /mock-pay page that simulates the webhook. Never enable mock payments in prod.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ── Resend (delivery + lifecycle emails) ─────────────────────────────────────
# Without a key, emails are logged to console and collected in-memory.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="VisaShot <photos@visashot.example>"

# ── Analytics & monitoring ───────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_dummy_posthog_key_1234567890
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Error monitoring. Wiring is in place (lib/monitoring.ts captures every pipeline
# / payment / fulfillment failure; app/error + app/global-error report client
# errors). It forwards to @sentry/nextjs once that package is installed AND this
# DSN is set; until then it degrades to a console-only no-op.
SENTRY_DSN=https://dummy-public-key@o000000.ingest.sentry.io/0000000

# ── Abuse protection ─────────────────────────────────────────────────────────
# Cloudflare Turnstile (invisible). Without keys, verification is mocked (pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAdummy_turnstile_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAAdummy_turnstile_secret_key

# ── Security secrets (generate long random strings) ──────────────────────────
# HMAC key for signed, expiring download links. REQUIRED in production.
DOWNLOAD_SIGNING_SECRET=dummy-32-byte-hex-or-base64-random-signing-secret-value-123456
# Shared secret for cron endpoints (purge, reminders, recovery).
CRON_SECRET=dummy-cron-secret-token-abcdef1234567890
# Token gating /admin (interim until proper auth; see PROJECT_STATE NEEDS HUMAN).
ADMIN_TOKEN=dummy-admin-bearer-token-secret-xyz987654321
# Comma-separated allowlist shown on admin audit log entries.
ADMIN_EMAILS=admin@visashot.example,ops@visashot.example

# ── Feature flags ────────────────────────────────────────────────────────────
# Abandoned-order recovery email with 20% code (single send at +4h).
RECOVERY_EMAILS_ENABLED=false
# Stripe promotion code id used by the recovery email (create in Stripe first).
RECOVERY_PROMO_CODE=promo_dummy_recovery_code_20off
