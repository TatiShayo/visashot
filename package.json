    "posthog-node": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^4.0.0",
    "sharp": "^0.34.0",
    "stripe": "^18.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
